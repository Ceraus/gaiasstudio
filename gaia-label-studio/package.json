{
  "name": "gaia-label-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gaia's Label Studio — an offline-first, Canva-like label & sticker editor with an Avery print-routing engine.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "avery:generate": "node scripts/generate-avery-dataset.mjs",
    "avery:scrape": "node scripts/scrape-avery.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/dancing-script": "^5.1.0",
    "@fontsource/eb-garamond": "^5.1.0",
    "@fontsource/great-vibes": "^5.1.0",
    "@fontsource/josefin-sans": "^5.1.0",
    "@fontsource/lora": "^5.1.0",
    "@fontsource/montserrat": "^5.1.0",
    "@fontsource/parisienne": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@fontsource/poppins": "^5.1.0",
    "@fontsource/raleway": "^5.1.0",
    "dexie": "^4.0.10",
    "fabric": "^6.5.4",
    "i18next": "^23.16.8",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
