{
  "name": "gaia-label-studio",
  "private": true,
  "version": "2.0.44",
  "description": "Gaia's Label Studio — an offline-first, Canva-like label & sticker editor with an Avery print-routing engine.",
  "author": "Rosa Suarez (Gaia's Essences)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "restore:rosa": "node scripts/restore-rosa-data.mjs",
    "sync:i18n": "node scripts/sync-ingredient-i18n.mjs",
    "typecheck": "tsc -b --noEmit",
    "avery:generate": "node scripts/generate-avery-dataset.mjs",
    "avery:scrape": "node scripts/scrape-avery.mjs",
    "electron:start": "electron .",
    "ai:fetch-model": "node scripts/fetch-bundled-model.mjs",
    "predist:win": "npm run ai:fetch-model && npm version patch --no-git-tag-version",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --x64",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/dancing-script": "^5.1.0",
    "@fontsource/eb-garamond": "^5.1.0",
    "@fontsource/great-vibes": "^5.1.0",
    "@fontsource/josefin-sans": "^5.1.0",
    "@fontsource/lora": "^5.1.0",
    "@fontsource/montserrat": "^5.1.0",
    "@fontsource/parisienne": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@fontsource/poppins": "^5.1.0",
    "@fontsource/raleway": "^5.1.0",
    "dexie": "^4.0.10",
    "fabric": "^6.5.4",
    "i18next": "^23.16.8",
    "lucide-react": "^0.468.0",
    "node-llama-cpp": "^3.19.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.gaiasessences.labelstudio",
    "productName": "Gaia's Label Studio",
    "copyright": "Copyright © Gaia's Essences",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-llama-cpp/**/*",
      "node_modules/@node-llama-cpp/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design"
    },
    "dmg": {
      "title": "Gaia's Label Studio",
      "artifactName": "${productName}-${version}-Setup.dmg"
    }
  }
}
