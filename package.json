{
  "name": "gaia-studio",
  "private": true,
  "version": "3.0.9",
  "description": "Gaia's Studio — an offline-first business hub for Gaia's Essences: labels, recipes, inventory, orders, finances, and Etsy integration.",
  "author": "Rosa Suarez (Gaia's Essences)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "preview": "vite preview",
    "smoke": "npm run build:e2e && node scripts/smoke.mjs",
    "sync:i18n": "node scripts/sync-ingredient-i18n.mjs",
    "catalog:offline": "node scripts/build-offline-ingredient-catalog.mjs",
    "icons:comfy": "node scripts/generateComfyIcons.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "avery:generate": "node scripts/generate-avery-dataset.mjs",
    "avery:scrape": "node scripts/scrape-avery.mjs",
    "avery:scrape:browser": "node scripts/scrape-avery.mjs --browser",
    "avery:scrape:docx": "node scripts/scrape-avery-docx.mjs",
    "avery:import:glabels": "node --use-system-ca scripts/import-glabels-avery.mjs",
    "avery:verify:pages": "node --use-system-ca scripts/verify-avery-pages.mjs",
    "electron:start": "electron .",
    "predist:win": "npm version patch --no-git-tag-version",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --x64",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/dancing-script": "^5.1.0",
    "@fontsource/eb-garamond": "^5.1.0",
    "@fontsource/great-vibes": "^5.1.0",
    "@fontsource/josefin-sans": "^5.1.0",
    "@fontsource/lora": "^5.1.0",
    "@fontsource/montserrat": "^5.1.0",
    "@fontsource/parisienne": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@fontsource/poppins": "^5.1.0",
    "@fontsource/raleway": "^5.1.0",
    "dexie": "^4.0.10",
    "fabric": "^6.5.4",
    "i18next": "^23.16.8",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "puppeteer": "^25.8.0",
    "puppeteer-core": "^25.3.0",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.gaiasessences.studio",
    "productName": "Gaia's Studio",
    "copyright": "Copyright © Gaia's Essences",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack-win-icon.cjs",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design"
    },
    "dmg": {
      "title": "Gaia's Studio",
      "artifactName": "${productName}-${version}-Setup.dmg"
    }
  }
}
