# Frontend build.
# Do not put Microsoft client secrets, Sanctum tokens, or backend secrets in Vite env files.

VITE_APP_URL=http://localhost:5173

# Command Laravel API base URL. Command 1 prefers VITE_API_URL and keeps
# VITE_LARAVEL_API_URL as a legacy alias. VITE_API_BASE_URL is still accepted
# by this template for older ClearPlan builds.
VITE_API_URL=https://api.clearviewglobal.net
# VITE_LARAVEL_API_URL=https://api.clearviewglobal.net
# VITE_API_BASE_URL=https://api.clearviewglobal.net

VITE_API_TIMEOUT_MS=15000
VITE_API_RETRY_COUNT=2

# When true, the Axios gateway resolves taxonomy-compliant seed data locally.
# VITE_USE_MOCKS=false
